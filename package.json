{
  "name": "nerve-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "test": "vitest run",
    "typecheck": "for p in packages/* examples/*; do (cd $p && node ../../node_modules/typescript-7/bin/tsc -p . --noEmit) || exit 1; done",
    "typecheck:ts5": "for p in packages/* examples/*; do (cd $p && bunx tsc -p . --noEmit) || exit 1; done",
    "build": "bun run --filter './packages/*' build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25.9.2",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.9",
    "effect": "^3.16.0",
    "fast-check": "^4.8.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "eval-corpus"
  ],
  "dependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "qs": "^6.15.3",
    "undici": "^8.7.0"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "undici": "^7.28.0",
    "fast-uri": "^3.1.4",
    "brace-expansion": "^5.0.8"
  }
}
